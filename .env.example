# EDXSO Influencer Outreach
# Copy to .env and fill as needed

NICHE=technology
PLATFORM=youtube
MIN_FOLLOWERS=5000
MAX_FOLLOWERS=100000
MIN_ENGAGEMENT_RATE=0.01
DISCOVERY_LIMIT=60
BRAND_NAME=EDXSO
BRAND_VALUE_PROP=AI-powered creator collaboration tools for tech educators and builders
COLLAB_TYPE=UGC content creation

# Optional — improves discovery volume/quality
YOUTUBE_API_KEY=

# Optional — real email sending (leave empty to simulate)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional — OpenAI-compatible personalization (falls back to local template engine)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DATA_DIR=data
DATABASE_PATH=data/outreach.db
LOG_LEVEL=INFO
