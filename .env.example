# EDXSO Influencer Outreach
# Copy to .env and fill as needed

NICHE=technology
PLATFORM=youtube
MIN_FOLLOWERS=5000
MAX_FOLLOWERS=100000
MIN_ENGAGEMENT_RATE=0.01
DISCOVERY_LIMIT=60
BRAND_NAME=EDXSO
BRAND_VALUE_PROP=AI-powered creator collaboration tools for tech educators and builders
COLLAB_TYPE=UGC content creation

# Optional — improves discovery volume/quality
YOUTUBE_API_KEY=

# Optional — real email sending (leave empty to simulate)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional — LLM personalization (OpenAI-compatible endpoints)
# Sample run used Gemini:
#   OPENAI_API_KEY=<GEMINI_API_KEY>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-flash-lite-latest
#   OPENAI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-lite-latest
OPENAI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash

DATA_DIR=data
DATABASE_PATH=data/outreach.db
LOG_LEVEL=INFO
